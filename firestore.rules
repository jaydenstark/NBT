rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }
    function isSupplier() {
      return isAuthenticated() && getUserData().role == 'supplier';
    }
    function isStaff() {
      return isAuthenticated() && getUserData().role == 'staff';
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. USERS
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isStaff();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. SUPPLIERS
    match /suppliers/{supplierId} {
      allow read: if true; // Public or authenticated? Make it public for now so products can show supplier
      allow write: if isAdmin() || isStaff();
    }

    // 3. PRODUCTS
    match /products/{productId} {
      allow read: if true; // Products are public
      allow write: if isAdmin() || isStaff() || isSupplier(); // Assuming suppliers can edit products
    }

    // 4. CARTS
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 5. ORDERS
    match /orders/{orderId} {
      allow read: if isAdmin() || isStaff() || (isAuthenticated() && resource.data.buyerId == request.auth.uid) || (isSupplier() && request.auth.uid in resource.data.assignedSuppliers);
      allow create: if isAuthenticated();
      allow update: if isAdmin() || isStaff() || isSupplier();
      allow delete: if isAdmin();
    }

    // 6. PURCHASE ORDERS
    match /purchaseOrders/{poId} {
      allow read: if isAdmin() || isStaff() || (isSupplier() && resource.data.supplierId == request.auth.uid);
      allow update: if isAdmin() || isStaff() || (isSupplier() && resource.data.supplierId == request.auth.uid);
      allow create, delete: if isAdmin() || isStaff();
    }

    // 7. INVOICES
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || isStaff() || (isAuthenticated() && resource.data.buyerId == request.auth.uid);
      allow write: if isAdmin() || isStaff();
    }

    // 8. COMMISSIONS
    match /commissions/{commissionId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    // 9. SUBSCRIPTIONS
    match /subscriptions/{subscriptionId} {
      allow read, update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // 10. CATEGORIES
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff();
    }

    // 11. DELIVERIES
    match /deliveries/{deliveryId} {
      allow read: if isAuthenticated(); // Could restrict to buyer/supplier involved in the order
      allow write: if isAdmin() || isStaff();
    }

    // 12. ANALYTICS
    match /analytics/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
